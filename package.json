{
  "name": "simple-webmcp",
  "version": "0.1.0",
  "description": "Turn any JS/TS function into a WebMCP tool — function-first, type-safe, lean. One line: webmcp(fn) still callable, auto-registers with React lifecycle or globally.",
  "type": "module",
  "keywords": [
    "webmcp",
    "mcp",
    "ai",
    "tool",
    "sdk",
    "react",
    "nextjs",
    "typescript"
  ],
  "author": {
    "name": "Muhammed Emin Gure",
    "url": "https://github.com/emingure"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emingure/simple-webmcp.git"
  },
  "bugs": {
    "url": "https://github.com/emingure/simple-webmcp/issues"
  },
  "homepage": "https://github.com/emingure/simple-webmcp#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./polyfill": {
      "import": "./dist/polyfill.js",
      "require": "./dist/polyfill.cjs"
    },
    "./dev-polyfill": {
      "import": "./dist/dev-polyfill.js",
      "require": "./dist/dev-polyfill.cjs"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js",
      "require": "./dist/zod.cjs"
    },
    "./inspect": {
      "types": "./dist/inspect.d.ts",
      "import": "./dist/inspect.js",
      "require": "./dist/inspect.cjs"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js",
      "require": "./dist/devtools.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".agents/skills"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "npm run build && npm run typecheck && npm test && changeset publish",
    "release:manual:patch": "npm version patch -m 'chore(release): %s' && git push --follow-tags && echo 'Tag pushed — release.yml will publish'",
    "release:manual:minor": "npm version minor -m 'chore(release): %s' && git push --follow-tags && echo 'Tag pushed — release.yml will publish'",
    "release:manual:major": "npm version major -m 'chore(release): %s' && git push --follow-tags && echo 'Tag pushed — release.yml will publish'",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "prepublishOnly": "npm run build && npm run typecheck && npm test",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@testing-library/react": "^14.3.1",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.12",
    "conventional-changelog-cli": "^5.0.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitepress": "^1.6.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
